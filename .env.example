# Configuration is passed at build time via --dart-define; this file is a
# reference for which values are needed, not something the app reads.
# See lib/core/config/env.dart.

# Root of the Django API, no trailing slash.
#   Android emulator reaches the host as 10.0.2.2, not 127.0.0.1.
#   Staging and production must be https.
DJANGO_API_BASE_URL=http://10.0.2.2:8000
